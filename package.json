{
  "name": "cardapio-digital",
  "version": "1.0.0",
  "description": "Cardápio digital acessado pelo QR Code da mesa",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "vitest run",
    "db:migrar": "node --env-file=.env src/db/migrar-cli.js",
    "db:resetar": "node --env-file=.env src/db/resetar.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
